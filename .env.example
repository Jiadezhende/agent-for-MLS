# Required for local runs. The course evaluator may inject API_KEY /
# BASE_MODEL / BASE_URL instead; run.sh maps those names to the internal names
# below.
OPENAI_API_KEY=your-api-key-here
AGENT_LLM_MODEL=gpt-4o-mini

# Optional LLM settings.
# Leave OPENAI_BASE_URL blank for the official OpenAI endpoint.
OPENAI_BASE_URL=
AGENT_LLM_MAX_TOKENS=4096
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT_S=120
AGENT_LLM_MAX_RETRIES=3

# Optional agent-loop settings.
AGENT_MAX_ITERATIONS=40
AGENT_KEEP_WORKSPACE=false
AGENT_WORKER_TIMEOUT_S=600
AGENT_CB_THRESHOLD=3
AGENT_HALF_OPEN_TIMEOUT_S=60

# Optional executor settings.
AGENT_WORKSPACE_ROOT=./workspace
AGENT_NVCC_BIN=nvcc

# Optional CUDA compiler helpers.
# On Windows, set AGENT_NVCC_CCBIN if nvcc cannot find MSVC automatically.
# Set AGENT_NVCC_FLAGS only when auto-detected architecture is wrong or missing,
# e.g. -O3 -arch=sm_120.
AGENT_NVCC_CCBIN=
AGENT_NVCC_FLAGS=

# Optional profiler/tool paths.
AGENT_NCU_BIN=ncu
AGENT_NSYS_BIN=nsys
AGENT_PYTHON_BIN=python

# Optional timeout/cache/output settings.
AGENT_COMPILE_TIMEOUT_S=120
AGENT_RUN_TIMEOUT_S=60
AGENT_PROFILE_TIMEOUT_S=600
AGENT_CACHE_ENABLED=true
AGENT_STDOUT_TRUNCATE_BYTES=64000
