# LLM credentials (required)
API_KEY=your-api-key-here
BASE_MODEL=gpt-4o-mini
BASE_URL=                             # blank = OpenAI; set for DeepSeek / vLLM / OpenRouter

# LLM settings
AGENT_LLM_MAX_TOKENS=8192
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_TIMEOUT_S=120
AGENT_LLM_MAX_RETRIES=3

# Agent loop
AGENT_MAX_ITERATIONS=40
AGENT_KEEP_WORKSPACE=false
AGENT_WORKER_TIMEOUT_S=600
AGENT_MAX_CRITIC_CYCLES=5
AGENT_MAX_WORKER_RETRIES=1
AGENT_CB_THRESHOLD=3
AGENT_HALF_OPEN_TIMEOUT_S=60

# Executor
AGENT_WORKSPACE_ROOT=./workspace
AGENT_NVCC_BIN=nvcc
AGENT_NVCC_CCBIN=
AGENT_NVCC_FLAGS=
AGENT_NCU_BIN=ncu
AGENT_NSYS_BIN=nsys
AGENT_PYTHON_BIN=python
AGENT_COMPILE_TIMEOUT_S=120
AGENT_RUN_TIMEOUT_S=60
AGENT_PROFILE_TIMEOUT_S=600
AGENT_CACHE_ENABLED=true
AGENT_STDOUT_TRUNCATE_BYTES=64000
